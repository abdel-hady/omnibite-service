generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum UserRole {
  CUSTOMER
  RESTAURANT
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  orders       Order[]
  restaurantId String? @unique
}

model Restaurant {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  cuisine     String?
  bannerImage String?
  rating      Float      @default(0)
  deliveryMin Int        @default(20) // minutes
  deliveryMax Int        @default(40)
  isActive    Boolean    @default(true)
  menuItems   MenuItem[]
  orders      Order[]
  createdAt   DateTime   @default(now())
  ownerId     String?    @unique
}

model MenuItem {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  description  String?
  price        Float
  category     String     // "Starters", "Mains", "Desserts"
  image        String?
  isAvailable  Boolean    @default(true)
  orderItems   OrderItem[]
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  restaurantId    String
  status          OrderStatus @default(PENDING)
  deliveryAddress Json
  createdAt       DateTime    @default(now())

  customer   User       @relation(fields: [customerId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  items      OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  menuItemId  String
  name        String
  price       Decimal
  quantity    Int

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
}
